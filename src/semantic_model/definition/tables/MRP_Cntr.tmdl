	column WERKS
		dataType: string
		summarizeBy: none
		sourceColumn: WERKS

	column Name
		dataType: string
		summarizeBy: none
		sourceColumn: Name

	column ResponsibilityArea
		dataType: string
		summarizeBy: none
		sourceColumn: ResponsibilityArea

	column Email
